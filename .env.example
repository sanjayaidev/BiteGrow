# Supabase -> Project Settings -> API. The service_role key is server-only: never expose it.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Optional. Used only to check customer passwords at sign-in; when empty the service_role key is used for that instead.
SUPABASE_ANON_KEY=

# Set to "production" when deployed: turns on template caching and disables the ?tenant=<slug> test override.
NODE_ENV=

# Tenant resolution (see src/tenant.js)
# Slug used when the host matches nothing (local development, single-client setups).
DEFAULT_TENANT=redhouse
# If set, <slug>.BASE_DOMAIN resolves to that tenant, e.g. redhouse.bitegrow.app
BASE_DOMAIN=

PORT=3000
# Needed in production behind Render/Railway/etc. so rate limits and hostnames use the real client values.
TRUST_PROXY_HOPS=1

# ---- Admin, Meta and AI assistant (see db/002_admin_meta_ai.sql) ----
# Encrypts Meta tokens and AI keys before they are saved. Required to store any secret. Use a long random string and never change it
# afterwards (saved secrets could not be read again).
APP_SECRET_KEY=
# Meta developer app (WhatsApp / Instagram / Messenger): the app secret signs every webhook call; the verify token is
# any string you type into Meta's webhook setup. Webhook URL: https://<your-domain>/webhooks/meta
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
# AI assistant (Alibaba Cloud Model Studio, OpenAI-compatible). One server-wide key serves every restaurant.
ALIBABA_API_KEY=
ALIBABA_WORKSPACE_ID=
ALIBABA_REGION=ap-southeast-1
ALIBABA_MODEL=qwen-plus
# Public address used in assistant replies when a customer asks how to order (default: https://<slug>.<BASE_DOMAIN>).
PUBLIC_BASE_URL=
