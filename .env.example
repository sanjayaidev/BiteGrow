# Supabase -> Project Settings -> API. The service_role key is server-only: never expose it.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Tenant resolution (see src/tenant.js)
# Slug used when the host matches nothing (local development, single-client setups).
DEFAULT_TENANT=redhouse
# If set, <slug>.BASE_DOMAIN resolves to that tenant, e.g. redhouse.bitegrow.app
BASE_DOMAIN=

PORT=3000
# Needed in production behind Render/Railway/etc. so rate limits and hostnames use the real client values.
TRUST_PROXY_HOPS=1
# Existing options kept from the current server
ADMIN_PASSWORD=
FFMPEG_PATH=
